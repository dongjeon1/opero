<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Vehicle SDK: 주행거리(Odometer), 문(Door), 배터리 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- 안전벨트 체결(문 감지가 안 되는 차종의 탑승 감지 대체) -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- Pleos NaviHelper SDK -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- Pleos 음성 SDK -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- AAOS 표준 차량 속성: 주차 브레이크, 기어 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 데모 모드로 일반 안드로이드 기기에서도 실행할 수 있도록 required=false -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <application
        android:name=".OperoApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Opero">

        <!-- 차량(AAOS)에서만 존재하는 android.car 라이브러리. 일반 기기에서는 데모 모드로 동작 -->
        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 브리핑 카드를 보여줄 수 있도록 표시 (화면 조작은 정차 중에만 허용) -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <service
            android:name=".OperoService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Records business trips from vehicle events" />
        </service>
    </application>
</manifest>
